# ──────────────────────────────────────────
# Copy this file to .env and fill in values
# .env is gitignored — never commit it!
# ──────────────────────────────────────────

# ── Database ──────────────────────────────
# Option A (recommended): Neon / Supabase / Railway connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option B: individual variables (used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=daily_planner_db

# ── Auth ──────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Google OAuth ──────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Leave blank in Codespaces — auto-detected from CODESPACE_NAME
GOOGLE_CALLBACK_URL=
FRONTEND_URL=
